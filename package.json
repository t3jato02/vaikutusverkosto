{
  "name": "vaikutusverkosto",
  "version": "0.1.0",
  "private": true,
  "description": "Vaikutusverkosto — public evidence graph of Finnish influence, power, money and institutional relationships.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "ingest:parliament": "tsx scripts/run-agent.ts parliament-agent",
    "ingest:procurement": "tsx scripts/run-agent.ts procurement-agent",
    "agent": "tsx scripts/run-agent.ts",
    "ingest:seed": "tsx scripts/seed-demo.ts",
    "ingest:vaikuta:demo": "tsx scripts/seed-vaikuta-demo.ts",
    "ingest:media": "tsx scripts/seed-media.ts",
    "ingest:identity": "tsx scripts/seed-identity.ts",
    "registry:sync": "tsx scripts/sync-source-registry.ts",
    "seed:countries": "tsx scripts/seed-countries.ts",
    "release:gate": "node scripts/release-gate.mjs",
    "fix:mojibake": "tsx scripts/fix-mojibake.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "cytoscape": "^3.31.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.10",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@types/cytoscape": "^3.21.8",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.24",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
