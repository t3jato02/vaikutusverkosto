# ---- All environment variables (names only, no secrets) ----
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection (production uses the managed pooled URL).
DATABASE_URL="postgresql://vaikutus:vaikutus@localhost:5434/vaikutusverkosto?schema=public"

# Direct/session connection for migrations (required when DATABASE_URL points
# at a PgBouncer-style pooler). For Supabase: session-mode pooler on :5432.
DIRECT_URL=""

# Requests/minute/IP for the "public_read" rate-limit bucket (search, entities,
# money, changes, graph). Other buckets are fixed: corrections 10, auth 10,
# expensive 20.
API_RATE_LIMIT_PER_MINUTE=120

# Distributed rate limiting (Upstash Redis). Set BOTH or NEITHER.
#  - both set   -> shared sliding-window limit across all serverless instances
#  - neither    -> in-memory per-instance fallback (fine for dev/test; in
#                  production this means the effective public limit is higher,
#                  and public reads fail OPEN if the store is unreachable).
# Provision once: Vercel dashboard -> Storage -> Upstash Redis -> create, then
# it injects UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN automatically.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Admin auth. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Admin login password (timing-safe comparison).
ADMIN_PASSWORD=""

# Vercel Cron secret (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=""

# Canonical public origin — single source for canonical/OpenGraph/Twitter/
# sitemap/robots/structured-data URLs (src/lib/site.ts). REQUIRED in production
# (fail-fast, no placeholder-domain fallback). Dev falls back to :3000.
PUBLIC_BASE_URL=""

# ---- VAIKUTA module (production citizen participation) --------------------
# Master switches. Fail-safe defaults: payments and real external delivery are
# OFF until explicitly turned on (see src/lib/vaikuta/flags.ts).
VAIKUTA_ENABLED=true
VAIKUTA_PUBLIC_CAMPAIGNS=false
VAIKUTA_AI_ASSIST=true

# Payment & billing. Provider "mock" never charges; "stripe" is only engaged
# when PAYMENTS_ENABLED=true AND STRIPE_SECRET_KEY is set.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Message delivery. "mock" never sends; a real adapter additionally requires
# MESSAGE_DELIVERY_ENABLED=true.
MESSAGE_DELIVERY_ENABLED=false
MESSAGE_DELIVERY_PROVIDER=mock
