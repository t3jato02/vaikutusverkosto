// Vaikutusverkosto — database schema
// Postgres is the authoritative source of truth.
// Model inspired by investigative graph models (FollowTheMoney).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- entities

// Universal node: every Person / Organization / Company / GovernmentBody /
// PoliticalParty / Association / Foundation / Union / MediaOrganization /
// EducationalInstitution / Court / PublicAuthority / Project / Campaign /
// Asset / Contract / Decision / Event / Source is an entity.
enum EntityType {
  PERSON
  ORGANIZATION
  COMPANY
  GOVERNMENT_BODY
  POLITICAL_PARTY
  ASSOCIATION
  FOUNDATION
  UNION
  MEDIA_ORGANIZATION
  EDUCATIONAL_INSTITUTION
  COURT
  PUBLIC_AUTHORITY
  PENSION_INSTITUTION
  PROJECT
  CAMPAIGN
  ASSET
  CONTRACT
  DECISION
  EVENT
  OTHER
}

// PUBLIC confidence levels (section 18).
enum Confidence {
  VERIFIED
  HIGH
  MEDIUM
  LOW
  DISPUTED
}

// Evidence grade: source strength of a specific claim, independent of Confidence.
//   A — primary / official source
//   B — strong journalistic or institutional source
//   C — corroborated by several independent sources
//   D — a single secondary source
//   E — unverified; must never be shown as fact in the public UI
// (Convergent with the definition carried by sprint-media-yle; see
//  docs/institutional-power/PARALLEL_WORK_CONTRACT.md — schema-ownership note.)
enum EvidenceGrade {
  A
  B
  C
  D
  E
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  FORMER
  PROPOSED
  UNKNOWN
}

// ---------------------------------------------------------------- institutional power (foundation)
//
// Role types for a person's documented institutional role (RoleAssignment).
// A person may hold MANY of these simultaneously (former minister + company
// board chair + foundation trustee). No category is mutually exclusive, and no
// role type is a value judgment — the source documents the role.
enum RoleType {
  MP
  MINISTER
  MUNICIPAL_POLITICIAN
  CIVIL_SERVANT
  CEO
  DEPUTY_CEO
  EXECUTIVE
  BOARD_CHAIR
  BOARD_VICE_CHAIR
  BOARD_MEMBER
  SUPERVISORY_BOARD
  ADVISORY_BOARD
  COUNCIL_MEMBER
  DIRECTOR_GENERAL
  SECRETARY_GENERAL
  CHAIR
  PRESIDENT
  TRUSTEE
  REGULATOR
  POLITICAL_APPOINTEE
  OWNER_REPRESENTATIVE
  COMMITTEE_MEMBER
  SECTOR_COUNCIL
  ORGANISATION_LEADER
  UNION_LEADER
  NGO_LEADER
  FOUNDATION_EXECUTIVE
  JOURNALIST
  MEDIA_EXECUTIVE
  ACADEMIC_EXECUTIVE
  PROFESSOR
  INVESTOR
  BANKER
  INVESTMENT_BANKER
  INSTITUTIONAL_INVESTOR_EXECUTIVE
  PUBLIC_AGENCY_EXECUTIVE
  INFRASTRUCTURE_EXECUTIVE
  DEFENCE_INDUSTRY_EXECUTIVE
  LOBBYIST
  OTHER
}

// Neutral sector taxonomy for organisations. Multiple sectors per organisation
// (OrganizationSector). A sector is descriptive, never a risk signal, and is
// assigned only when a public source documents it.
enum Sector {
  ENERGY
  ELECTRICITY_TRANSMISSION
  ELECTRICITY_DISTRIBUTION
  DISTRICT_HEATING
  GAS
  WATER
  WASTE
  FOOD
  AGRICULTURE
  FOOD_LOGISTICS
  BANKING
  INVESTMENT
  INSURANCE
  PENSION
  PAYMENTS
  TRANSPORT
  RAIL
  AVIATION
  ROAD_TRANSPORT
  PUBLIC_TRANSIT
  PORT
  MARITIME
  LOGISTICS
  TELECOM
  DATA_NETWORK
  CLOUD
  CYBERSECURITY
  TECHNOLOGY
  PUBLIC_IT
  HEALTHCARE
  PHARMA
  SOCIAL_SECURITY
  EMERGENCY_SUPPLY
  AID_ORGANISATION
  NGO
  FOUNDATION
  EMPLOYER_ORGANISATION
  LABOUR_ORGANISATION
  MEDIA
  EDUCATION
  RESEARCH
  DEFENCE
  SECURITY
  STATE_OWNED
  MUNICIPAL_OWNED
  PUBLIC_AGENCY
  SPECIAL_ASSIGNMENT
  ALCOHOL_MONOPOLY
  GAMBLING
  OTHER
}

// Critical-function classification: the nationally significant function an
// organisation performs IN PUBLIC EVIDENCE. NEVER reconstructed from classified
// material, HVK lists, emergency plans or security-sensitive facility details.
enum CriticalFunction {
  NATIONAL_GRID
  LOCAL_GRID
  GAS_TRANSMISSION
  TELECOMMUNICATIONS
  PAYMENT_INFRASTRUCTURE
  FOOD_DISTRIBUTION
  RAIL_NETWORK
  AVIATION
  PORT_LOGISTICS
  WATER
  HEALTHCARE_SUPPLY
  DEFENCE_SUPPLY
  GOVERNMENT_IT
}

// Precision of a stored ownership percentage. A CALCULATED percentage is
// derived deterministically from stated data (never guessed).
enum OwnershipCalculationStatus {
  REPORTED // stated by the source
  CALCULATED // derived deterministically (e.g. share counts / ratios)
  UNKNOWN // precision not disclosed
}

// Public-procurement procedure (Hankintalaki). Neutral — procurement is a
// relationship, never an influence accusation.
enum ProcurementProcedure {
  OPEN
  RESTRICTED
  NEGOTIATED
  COMPETITIVE_DIALOGUE
  INNOVATION_PARTNERSHIP
  DIRECT_AWARD
  FRAMEWORK_AGREEMENT
  OTHER
}

model Entity {
  id             String          @id @default(uuid()) @db.Uuid
  type           EntityType
  subtype        String?
  canonicalName  String
  description    String?         @db.Text
  status         EntityStatus    @default(ACTIVE)
  startDate      DateTime?       @db.Date
  endDate        DateTime?       @db.Date
  jurisdiction   String? // "FI", "FI-helsinki", "EU", ...
  municipality   String?
  region         String?
  country        String?
  countryCode    String? // ISO-3166 alpha-2 (Sprint C)
  entityCategory EntityCategory? // institutional classification (Sprint C)
  officialUrls   String[]        @default([])
  sourceCount    Int             @default(0)
  confidence     Confidence      @default(HIGH)
  lastVerifiedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Benefits / gifts / awards / hospitality (public media finance, section 6).
  recipientBenefitEvents BenefitEvent[]           @relation("BenefitRecipient")
  giverBenefitEvents     BenefitEvent[]           @relation("BenefitGiver")
  payerBenefitEvents     BenefitEvent[]           @relation("BenefitPayer")
  beneficiaryBenefitEvents BenefitEvent[]         @relation("BenefitBeneficiary")
  subjectBenefitEvents   BenefitEvent[]           @relation("BenefitSubject")
  artistBenefitEvents    BenefitEvent[]           @relation("BenefitArtist")
  // Year-by-year financial statements (public media finance, section 3).
  financialStatementItems FinancialStatementItem[]

  // Per-type extension records
  person       Person?
  organization Organization?
  mediaOutlet  MediaOutlet?

  aliases                       EntityAlias[]
  externalIds                   ExternalIdentifier[]
  personalFacts                 PersonalFact[]         @relation("PersonalFactPerson")
  politicalAffiliationsAsPerson PoliticalAffiliation[] @relation("PoliticalProfilePerson")
  politicalAffiliationsAsParty  PoliticalAffiliation[] @relation("PoliticalProfileParty")
  articlesPublished             Article[]              @relation("ArticlePublisher")
  authoredArticles              ArticleAuthor[]        @relation("AuthorOfArticle")
  articleMentions               ArticleMention[]       @relation("MentionedInArticle")
  outRelations                  Relationship[]         @relation("RelSource")
  inRelations                   Relationship[]         @relation("RelTarget")
  outFlows                      FinancialFlow[]        @relation("FlowPayer")
  inFlows                       FinancialFlow[]        @relation("FlowRecipient")
  positions                     Position[]             @relation("PositionPerson")
  orgPositions                  Position[]             @relation("PositionOrg")
  decisions                     Decision[] @relation("InstitutionDecisions") // institution decisions
  votes                         Vote[]
  events                        Event[]
  entityChanges                 ChangeLog[]
  corrections                   Correction[]
  sourceLinks                   Evidence[]
  replies                       RightOfReply[]

  // VAIKUTA module
  campaignRecipients            CampaignRecipient[]
  vaikutaContacts               VaikutaContactMethod[]
  decisionEntity                Decision? @relation("DecisionEntity") // the matching DECISION entity (VAIKUTA)

  // Identity framing (Syntymämaa & media-identiteetti) module.
  birthOriginFacts        BirthOriginFact[]        @relation("BirthOriginPerson")
  citizenshipFacts        CitizenshipFact[]        @relation("CitizenshipPerson")
  residenceFacts          ResidenceFact[]          @relation("ResidencePerson")
  selfIdentifications     SelfIdentificationFact[] @relation("SelfIdPerson")
  identityMentions        MediaIdentityMention[]   @relation("IdentityMentionPerson")
  identityMentionOutlets  MediaIdentityMention[]   @relation("IdentityMentionOutlet")
  identityMentionAuthors  MediaIdentityMention[]   @relation("IdentityMentionJournalist")

  // Institutional power (foundation).
  organizationSectors           OrganizationSector[] @relation("OrgSectors")
  criticalFunctions             CriticalFunctionAssignment[] @relation("CriticalFunctions")
  procurementAuthorityContracts ProcurementContract[] @relation("ProcurementAuthority")
  procurementSupplierContracts  ProcurementContract[] @relation("ProcurementSupplier")
  lobbyingEngagementsAsOrg      LobbyingEngagement[] @relation("LobbyingOrganization")
  lobbyingTargetEngagements     LobbyingEngagement[] @relation("LobbyingTarget")
  appointedPositions            Position[] @relation("PositionAppointedBy")

  // Institutional power (public-institutions stream).
  institutionalCategories       OrganizationInstitutionalCategory[] @relation("InstitutionalCategories")

  @@index([canonicalName])
  @@index([type, status])
  @@index([municipality])
  @@index([country])
  @@index([countryCode])
  @@index([entityCategory])
}

model Person {
  entityId          String   @id @db.Uuid
  entity            Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  birthYear         Int?
  profession        String?
  partyEntityId     String?  @db.Uuid
  electoralDistrict String?
  education         String?
  imageUrl          String?
  firstName         String?
  lastName          String?
  hetekaId          Int? // Eduskunta identifier
  // Journalism & media — journalist-specific fields (Toimittajat). The role
  // classification lives on Entity.subtype (JOURNALIST, EDITOR_IN_CHIEF, …);
  // these columns carry journalist-specific metadata that is *always* backed by
  // a documented public source (see PersonalFact for source-bound fields).
  activeYearsFrom   Int?
  activeYearsTo     Int?
  bioUrl            String? // official bio / employer bio
  professionalBio   String?  @db.Text
  writtenLanguages  String[] @default([]) // ISO-639-1; only when a source documents them
  specialties       String[] @default([]) // erikoisalat (julkisesti dokumentoitu)
  topicAreas        String[] @default([]) // aihealueet

  @@index([hetekaId])
  @@index([partyEntityId])
}

model Organization {
  entityId           String   @id @db.Uuid
  entity             Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  registrationNumber String?
  legalForm          String?
  foundingYear       Int?
  headquarters       String?
  employeeCount      Int?
  revenueEur         Decimal? @db.Decimal(18, 2)

  @@index([registrationNumber])
}

model EntityAlias {
  id        String  @id @default(uuid()) @db.Uuid
  entityId  String  @db.Uuid
  entity    Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name      String
  language  String? // fi / en / sv / null (any)
  aliasType String  @default("NAME_VARIANT") // NAME_VARIANT, TRANSLITERATION, PREVIOUS_NAME, COMMON_NAME

  @@unique([entityId, name, aliasType])
  @@index([name])
}

model ExternalIdentifier {
  id         String @id @default(uuid()) @db.Uuid
  entityId   String @db.Uuid
  entity     Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  provider   String // eduskunta, ytj, prh, wikipedia, ...
  identifier String

  @@unique([provider, identifier])
  @@index([provider])
}

// ---------------------------------------------------------------- media & journalism (Toimittajat & media)

// Evidence grade (section 9): see EvidenceGrade above (shared with
// institutional-power foundation — same A-E source-strength scale).

// Journalist role classification. Stored on Entity.subtype for PERSON entities;
// NOT a political stance — a professional classification. The subtype sets live
// in src/lib/journalism.ts (labels + URL routing); schema has no enum here.
// Media classification. Stored on Entity.subtype for MEDIA_ORGANIZATION.

// Biographic fields that are NEVER inferred: only recorded when a public
// source documents them explicitly (section 20). UNKNOWN otherwise.
enum PersonalFactType {
  BIRTH_COUNTRY
  NATIVE_LANGUAGE
  WORK_LANGUAGE
  NATIONALITY
  MOTHER_TONGUE
}

model PersonalFact {
  id                 String             @id @default(uuid()) @db.Uuid
  personEntityId     String             @db.Uuid
  personEntity       Entity             @relation("PersonalFactPerson", fields: [personEntityId], references: [id], onDelete: Cascade)
  factType           PersonalFactType
  value              String
  proficiency        String? // language proficiency (e.g. "C2", "Äidinkieli") only when documented
  sourceUrl          String
  sourceName         String
  publicationDate    DateTime?          @db.Date
  retrievedAt        DateTime?          @default(now())
  confidence         Confidence         @default(HIGH)
  verificationStatus VerificationStatus @default(SOURCE_CONFIRMED)
  evidenceGrade      EvidenceGrade      @default(C)
  note               String?            @db.Text
  createdAt          DateTime           @default(now())

  @@unique([personEntityId, factType, value, sourceUrl])
  @@index([personEntityId])
}

// Political-affiliation facts with a strict, non-inferring model (section 3).
// The four types are kept absolutely separate:
//   A DECLARED_POLITICAL_AFFILIATION      — the person's own declared membership/
//                                          candidacy/appointment, source-required.
//   B DOCUMENTED_POLITICAL_RELATIONSHIP   — documented professional/organisational
//                                          connection to a political actor.
//   C SELF_DESCRIBED_POLITICAL_VIEW       — the person's own verbatim public
//                                          self-description; stored word-for-word.
// There is NO "content pattern => political view" row type in this table: that
// lives in ContentAnalysis and is labelled as automatic analysis, never as the
// person's view.
enum AffiliationType {
  DECLARED_POLITICAL_AFFILIATION
  DOCUMENTED_POLITICAL_RELATIONSHIP
  SELF_DESCRIBED_POLITICAL_VIEW
}

enum AffiliationReviewStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  DISPUTED
}

model PoliticalAffiliation {
  id                 String                  @id @default(uuid()) @db.Uuid
  personEntityId     String                  @db.Uuid
  personEntity       Entity                  @relation("PoliticalProfilePerson", fields: [personEntityId], references: [id], onDelete: Cascade)
  affiliationType    AffiliationType
  partyEntityId      String?                 @db.Uuid
  partyEntity        Entity?                 @relation("PoliticalProfileParty", fields: [partyEntityId], references: [id], onDelete: SetNull)
  role               String? // e.g. "kunnallisvaaliehdokas", "ministerin avustaja"
  description        String                  @db.Text
  verbatimText       String?                 @db.Text // SELF_DESCRIBED_POLITICAL_VIEW only — exact wording
  selfReported       Boolean                 @default(false) // stated by the person themselves
  // Time dimension is mandatory context (section 35): a past candidacy never
  // becomes a present-day stance.
  startYear          Int?
  endYear            Int?
  isCurrent          Boolean?
  sourceUrl          String
  sourceName         String
  publicationDate    DateTime?               @db.Date
  retrievedAt        DateTime?               @default(now())
  confidence         Confidence              @default(HIGH)
  verificationStatus VerificationStatus      @default(SOURCE_CONFIRMED)
  evidenceGrade      EvidenceGrade           @default(C)
  reviewStatus       AffiliationReviewStatus @default(PENDING_REVIEW)
  reviewedBy         String?
  reviewedAt         DateTime?
  createdBy          String? // agent name or "human"
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([personEntityId])
  @@index([partyEntityId])
  @@index([affiliationType])
  @@index([reviewStatus])
}

// ---------------------------------------------------------------- identity framing (Syntymämaa & media-identiteetti)
//
// Faktakerros, joka pitää erillään toisistaan:
//   1. SYNTOMÄMAA/SYNTOMÄPAIKKA  — muuttumaton historiallinen fakta
//   2. KANSALAISUUS              — juridinen status (voi olla useita)
//   3. ASUINMAA / ASUMHISTORIA   — muuttuva tieto
//   4. HENKILÖN OMA IDENTIFIKAATIO — vain eksplisiittisestä julkisesta lähteestä
//   5. MEDIAN KÄYTTÄMÄ ILMAUS     — toimituksellinen havainto, säilytetään sanatarkasti
// Nämä kentät EI SAA yhdistää yhdeksi 'nationality'-kentäksi. Mikään näistä ei
// synny nimestä, kielestä, kuvasta tai ulkonäöstä — vain dokumentoidusta
// lähteestä. Syntymämaa EI muutu kansalaisuudeksi (eikä päinvastoin).

enum OriginFactKind {
  BIRTH_COUNTRY // value = ISO-3166 alpha-2, displayValue = maan nimi
  BIRTH_PLACE // value = paikkakunta, displayValue = paikkakunta (+ alue)
}

enum CitizenshipStatus {
  CURRENT
  FORMER
  UNKNOWN
}

enum IdentityReviewStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  DISPUTED
}

// Median käyttämän ilmauksen luokka. Luokka luokittelee ILMAUKSEN tyypin
// (kansallisuusnimitys vs. juridiikka vs. paikallisuus), EI henkilöä.
enum MediaIdentityTermCategory {
  NATIONALITY // suomalainen, nepalilainen
  CITIZENSHIP // Suomen kansalainen
  RESIDENCE // Suomessa asuva
  PLACE_OF_BIRTH // Suomessa syntynyt
  IMMIGRATION_STATUS // maahanmuuttaja, pakolainen, ulkomaalaistaustainen
  CITY_IDENTITY // helsinkiläinen
  REGION_IDENTITY // pohjalainen
  OTHER
}

// Muuttumaton syntymämaatausta. Syntymämaa/paikka on historiallinen fakta,
// joka ei muutu muuton, asumisen, kansalaisuuden tai kaksosikansalaisuuden
// myötä. Ei koskaan kirjoiteta 'kansalaisuus'-arvoksi.
model BirthOriginFact {
  id                 String             @id @default(uuid()) @db.Uuid
  personEntityId     String             @db.Uuid
  personEntity       Entity             @relation("BirthOriginPerson", fields: [personEntityId], references: [id], onDelete: Cascade)
  factKind           OriginFactKind
  value              String // BIRTH_COUNTRY => ISO2; BIRTH_PLACE => paikkakunta
  displayValue       String // ihmislukema (maa- tai paikkakuntanimi)
  sourceUrl          String
  sourceName         String
  publicationDate    DateTime?          @db.Date
  retrievedAt        DateTime?          @default(now())
  confidence         Confidence         @default(HIGH)
  verificationStatus VerificationStatus @default(SOURCE_CONFIRMED)
  evidenceGrade      EvidenceGrade      @default(C)
  reviewStatus       IdentityReviewStatus @default(PENDING_REVIEW)
  reviewedBy         String?
  reviewedAt         DateTime?
  createdBy          String?
  note               String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([personEntityId, factKind, value, sourceUrl])
  @@index([personEntityId])
  @@index([factKind])
  @@index([reviewStatus])
}

// Juridinen kansalaisuus nykyhetkellä/historiassa. Voi olla useampi rivi
// (kaksoiskansalaisuus: eri countryCode, molemmat CURRENT). Saavuusvuosi
// vain, jos se on dokumentoitu. Ei johdeta syntymämaasta.
model CitizenshipFact {
  id                 String             @id @default(uuid()) @db.Uuid
  personEntityId     String             @db.Uuid
  personEntity       Entity             @relation("CitizenshipPerson", fields: [personEntityId], references: [id], onDelete: Cascade)
  countryCode        String // ISO-3166 alpha-2
  countryName        String
  status             CitizenshipStatus  @default(CURRENT)
  acquiredYear       Int?
  endedYear          Int?
  sourceUrl          String
  sourceName         String
  publicationDate    DateTime?          @db.Date
  retrievedAt        DateTime?          @default(now())
  confidence         Confidence         @default(HIGH)
  verificationStatus VerificationStatus @default(SOURCE_CONFIRMED)
  evidenceGrade      EvidenceGrade      @default(C)
  reviewStatus       IdentityReviewStatus @default(PENDING_REVIEW)
  reviewedBy         String?
  reviewedAt         DateTime?
  createdBy          String?
  note               String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([personEntityId, countryCode, status, sourceUrl])
  @@index([personEntityId])
  @@index([countryCode])
  @@index([reviewStatus])
}

// Asuinmaa / asumishistoria. Eri asia kuin syntymämaa ja kansalaisuus.
// Alku-/loppuaika aina jos dokumentoitu; varmuustaso lähdeperusteinen.
model ResidenceFact {
  id                 String             @id @default(uuid()) @db.Uuid
  personEntityId     String             @db.Uuid
  personEntity       Entity             @relation("ResidencePerson", fields: [personEntityId], references: [id], onDelete: Cascade)
  countryCode        String? // ISO-3166 alpha-2
  countryName        String?
  municipality       String?
  startDate          DateTime?          @db.Date
  endDate            DateTime?          @db.Date
  isCurrent          Boolean            @default(false)
  sourceUrl          String
  sourceName         String
  publicationDate    DateTime?          @db.Date
  retrievedAt        DateTime?          @default(now())
  confidence         Confidence         @default(HIGH)
  verificationStatus VerificationStatus @default(SOURCE_CONFIRMED)
  evidenceGrade      EvidenceGrade      @default(C)
  reviewStatus       IdentityReviewStatus @default(PENDING_REVIEW)
  reviewedBy         String?
  reviewedAt         DateTime?
  createdBy          String?
  note               String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([personEntityId, countryCode, municipality, startDate, endDate, sourceUrl])
  @@index([personEntityId])
  @@index([countryCode])
  @@index([reviewStatus])
}

// Henkilön OMA julkinen identiteettikuvaus: vain eksplisiittisestä julkisesta
// lähteestä, säilytetään sanatarkasti. Ei koskaan päätelty.
model SelfIdentificationFact {
  id                 String             @id @default(uuid()) @db.Uuid
  personEntityId     String             @db.Uuid
  personEntity       Entity             @relation("SelfIdPerson", fields: [personEntityId], references: [id], onDelete: Cascade)
  identityLabel      String // normalisoitu etiketti, esim. "suomalainen", "helsinkiläinen"
  verbatimText       String             @db.Text // sanatarkka julkinen lainaus
  language           String? // ISO-639-1
  sourceUrl          String
  sourceName         String
  publicationDate    DateTime?          @db.Date
  retrievedAt        DateTime?          @default(now())
  confidence         Confidence         @default(HIGH)
  verificationStatus VerificationStatus @default(SOURCE_CONFIRMED)
  evidenceGrade      EvidenceGrade      @default(C)
  reviewStatus       IdentityReviewStatus @default(PENDING_REVIEW)
  reviewedBy         String?
  reviewedAt         DateTime?
  createdBy          String?
  note               String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([personEntityId, identityLabel, sourceUrl])
  @@index([personEntityId])
  @@index([reviewStatus])
}

// Median käyttämä ilmaus yhdessä jutussa yhdestä henkilöstä. Ilmaus
// tallennetaan SANATARKASTI sellaisena kuin se julkaisussa on. Tämä on
// toimituksellinen havainto — ei henkilön ominaisuus eikä näyttö puolueellisuudesta.
model MediaIdentityMention {
  id                   String                 @id @default(uuid()) @db.Uuid
  personEntityId       String                 @db.Uuid
  personEntity         Entity                 @relation("IdentityMentionPerson", fields: [personEntityId], references: [id], onDelete: Cascade)
  articleId            String                 @db.Uuid
  article              Article                @relation(fields: [articleId], references: [id], onDelete: Cascade)
  expression           String // median käyttämä ilmaus, sanatarkka
  expressionNormalized String // pienellä kirjoitettu, trimattu — ryhmittelyyn
  termCategory         MediaIdentityTermCategory
  context              String?                @db.Text // lause/kappalekonteksti (lyhyt sitaatti)
  inHeadline           Boolean                @default(false)
  mediaOutletEntityId  String?                @db.Uuid
  mediaOutletEntity    Entity?                @relation("IdentityMentionOutlet", fields: [mediaOutletEntityId], references: [id], onDelete: SetNull)
  journalistEntityId   String?                @db.Uuid
  journalistEntity     Entity?                @relation("IdentityMentionJournalist", fields: [journalistEntityId], references: [id], onDelete: SetNull)
  publishedAt          DateTime?
  genre                String? // JournalisticGenre bucket, denormalisoitu
  // Versioidut analyysimetatiedot (luku 13): uudelleenlaskettavissa.
  analysisVersion      String                 @default("identity_framing_v1")
  algorithmVersion     String                 @default("identity_framing_v1")
  extractor            String                 @default("identity-framing-classifier-v1")
  modelVersion         String                 @default("lexicon-v1")
  promptVersion        String                 @default("none")
  confidence           Float // 0..1 luokittelun jäykkyys — ei "totuustodistus"
  sourceSnapshot       String? // hash syötteistä (otsikko + excerpt + konteksti)
  reviewStatus         IdentityReviewStatus   @default(PENDING_REVIEW)
  reviewedBy           String?
  reviewedAt           DateTime?
  note                 String?                @db.Text
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([personEntityId, articleId, expressionNormalized, termCategory])
  @@index([personEntityId])
  @@index([articleId])
  @@index([mediaOutletEntityId])
  @@index([journalistEntityId])
  @@index([expressionNormalized])
  @@index([termCategory])
  @@index([reviewStatus])
  @@index([publishedAt])
}

// Yksi versioitu luokitteluajo (ajanjakso + laajuus + versio). Toimii
// tilastona siitä, milloin mitkä maininnat laskettiin — uudelleenlaskettavissa.
model IdentityFramingAnalysis {
  id                 String        @id @default(uuid()) @db.Uuid
  scope              AnalysisScope
  scopeEntityId      String?       @db.Uuid
  scopeHash          String        @unique // scope + entity + period + algoritmiversio
  filters            Json?
  periodStart        DateTime?     @db.Date
  periodEnd          DateTime?     @db.Date
  algorithm          String        @default("identity_framing_v1")
  algorithmVersion   String        @default("identity_framing_v1")
  modelVersion       String        @default("lexicon-v1")
  promptVersion      String        @default("none")
  articleCount       Int           @default(0)
  mentionCount       Int           @default(0)
  sourceSnapshot     String? // hash syötteistä
  confidence         Float?
  summary            String?       @db.Text
  computedAt         DateTime      @default(now())
  computedFromUpdatedAt DateTime?

  @@index([scopeEntityId])
  @@index([scope, algorithm])
}

// Valmiiksi laskettu jakauma (media / toimittaja / korpus / termi / henkilö).
// Tulokset ovat HAVAINTOJA median sanavalinnoista, ei henkilöiden tietoja.
enum IdentityAggregateScope {
  OUTLET
  JOURNALIST
  CORPUS
  TERM
  PERSON
}

model IdentityFramingAggregate {
  id                 String                @id @default(uuid()) @db.Uuid
  scope              IdentityAggregateScope
  scopeEntityId      String?               @db.Uuid
  scopeHash          String                @unique
  filters            Json?
  periodStart        DateTime?             @db.Date
  periodEnd          DateTime?             @db.Date
  algorithmVersion   String                @default("identity_framing_v1")
  sampleSize         Int                   @default(0) // henkilötapausten määrä
  mentionCount       Int                   @default(0)
  result             Json
  computedAt         DateTime              @default(now())
  computedFromUpdatedAt DateTime?

  @@index([scopeEntityId])
  @@index([scope, algorithmVersion])
}

// Käänteistapausvertailun tilastollinen ajonäyte. Raportoi vain dataa;
// pienellä otoksella ei väitetä efektiä (INSUFFICIENT_SAMPLE).
model IdentityComparison {
  id                 String     @id @default(uuid()) @db.Uuid
  direction          String // "inbound_foreign_to_fi" | "outbound_fi_to_foreign"
  specHash           String     @unique
  algorithmVersion   String     @default("reverse_case_v1")
  sampleSizeA        Int        @default(0)
  sampleSizeB        Int        @default(0)
  matchedPairs       Int        @default(0)
  status             String     @default("COMPLETED") // COMPLETED | INSUFFICIENT_SAMPLE | ERROR
  effectSize         Float?
  effectSizeType     String? // "cohens_h"
  confidenceInterval Json? // Wilsonin intervallit osuuksille
  missingDataRate    Float?
  matchingQuality    Float? // 0..1 — kuinka monta kohortin tapausta sai parin
  confounders        Json?
  result             Json? // koko ajon tulokset
  computedAt         DateTime   @default(now())

  @@index([direction])
  @@index([status])
}

// Media outlet / publisher profile (section 6 & 19). One row per
// MEDIA_ORGANIZATION entity that is an outlet/publisher. The editorial
// affiliation is an *institutional* attribute recorded only from a documented
// source — it is never transferred to individual journalists.
enum MediaOutletType {
  NEWS_PAPER
  BROADCASTER
  MAGAZINE
  ONLINE_MEDIA
  NEWS_AGENCY
  PARTY_MEDIA
  OTHER
}

enum EditorialAffiliationType {
  FORMALLY_PARTY_AFFILIATED
  HISTORICALLY_PARTY_AFFILIATED
  INDEPENDENT
  SELF_DESCRIBED
  UNKNOWN
}

model MediaOutlet {
  entityId                          String                   @id @db.Uuid
  entity                            Entity                   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  websiteUrl                        String?
  mediaOutletType                   MediaOutletType          @default(OTHER)
  foundingYear                      Int?
  countryCode                       String? // ISO-3166 alpha-2
  publishLanguages                  String[]                 @default([])
  jsnMember                         Boolean                  @default(false)
  jsnSourceUrl                      String?
  fundingModel                      String?
  fundingModelSourceUrl             String?
  editorialAffiliationType          EditorialAffiliationType @default(UNKNOWN)
  editorialAffiliationPartyEntityId String?                  @db.Uuid
  editorialAffiliationSourceUrl     String?

  @@index([mediaOutletType])
  @@index([editorialAffiliationType])
}

// ---------------------------------------------------------------- article database (section 12)
//
// Metadata-first article storage: we store title, canonical URL, authors,
// genre, mentions, topics and analysis outputs — NOT full copyrighted text.
// The canonical URL is unique; the full text stays with the publisher.
enum JournalisticGenre {
  NEWS
  ANALYSIS
  COMMENT
  COLUMN
  OPINION
  INVESTIGATIVE
  INTERVIEW
  OTHER
}

enum MentionRole {
  SUBJECT
  SOURCE
  QUOTED_EXPERT
  ORGANIZATION
  COUNTRY
  TOPIC
}

model Article {
  id                String            @id @default(uuid()) @db.Uuid
  title             String
  canonicalUrl      String            @unique
  publicationName   String? // denormalized publisher name when no entity exists yet
  publisherEntityId String?           @db.Uuid
  publisherEntity   Entity?           @relation("ArticlePublisher", fields: [publisherEntityId], references: [id], onDelete: SetNull)
  publishedAt       DateTime?
  updatedAt         DateTime?
  genre             JournalisticGenre @default(OTHER)
  language          String? // ISO-639-1
  archivedUrl       String?
  excerpt           String?           @db.Text // short neutral summary / lede, not full text
  topics            String[]          @default([])
  analysisVersion   String?           @default("journalist_content_v1")
  sourceId          String?           @db.Uuid
  source            Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  ingestedAt        DateTime          @default(now())
  verifiedAt        DateTime?
  publicVisible     Boolean           @default(true)

  authors  ArticleAuthor[]
  mentions ArticleMention[]
  identityMentions MediaIdentityMention[]

  @@unique([title, publishedAt])
  @@index([publisherEntityId])
  @@index([publishedAt])
  @@index([genre])
}

model ArticleAuthor {
  id             String  @id @default(uuid()) @db.Uuid
  articleId      String  @db.Uuid
  article        Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  personEntityId String  @db.Uuid
  personEntity   Entity  @relation("AuthorOfArticle", fields: [personEntityId], references: [id], onDelete: Cascade)
  byline         String?
  authorOrder    Int     @default(0)

  @@unique([articleId, personEntityId])
  @@index([personEntityId])
}

model ArticleMention {
  id              String      @id @default(uuid()) @db.Uuid
  articleId       String      @db.Uuid
  article         Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  entityId        String      @db.Uuid
  entity          Entity      @relation("MentionedInArticle", fields: [entityId], references: [id], onDelete: Cascade)
  mentionRole     MentionRole @default(SUBJECT)
  headlineMention Boolean     @default(false)
  firstSegment    Boolean     @default(false) // mentioned in the first paragraph/segment

  @@unique([articleId, entityId, mentionRole])
  @@index([entityId])
}

// ---------------------------------------------------------------- content analysis (sections 4 & 13)
//
// Versioned, recomputable analysis results. A row is a snapshot of a pure
// deterministic computation over the article corpus; identical inputs always
// produce an identical result (algorithmVersion pins the method).
enum AnalysisScope {
  JOURNALIST
  MEDIA_OUTLET
  CORPUS
  TOPIC
}

enum AnalysisKind {
  COVERAGE_METRICS
  PARTY_COVERAGE
  PERSON_COVERAGE
  GENRE_DISTRIBUTION
  TOPIC_DISTRIBUTION
  COUNTRY_DISTRIBUTION
  SOURCE_TYPE_DISTRIBUTION
  FRAMING_DISTRIBUTION
  MEDIA_COMPARISON
}

model ContentAnalysis {
  id                    String        @id @default(uuid()) @db.Uuid
  scope                 AnalysisScope
  scopeEntityId         String?       @db.Uuid
  scopeHash             String        @unique // deterministic key: scope+entity+period+algorithm
  kind                  AnalysisKind
  periodStart           DateTime?     @db.Date
  periodEnd             DateTime?     @db.Date
  corpusSize            Int           @default(0)
  articleCount          Int           @default(0)
  politicsArticleCount  Int           @default(0)
  algorithm             String        @default("journalist_content_v1")
  algorithmVersion      String
  confidenceScore       Float? // coverage robustness 0..1; not a truth score
  result                Json
  summary               String?       @db.Text
  computedAt            DateTime      @default(now())
  computedFromUpdatedAt DateTime? // latest Article.updatedAt included in the corpus

  @@index([scopeEntityId])
  @@index([scope, kind])
}

// ---------------------------------------------------------------- relationships

enum RelationshipType {
  OWNS
  BENEFICIAL_OWNER_OF
  BOARD_MEMBER_OF
  CHAIRS
  EMPLOYED_BY
  APPOINTED_BY
  APPOINTED_TO
  MEMBER_OF
  FORMER_MEMBER_OF
  ADVISER_TO
  DONATED_TO
  FUNDED_BY
  FUNDS
  RECEIVED_GRANT_FROM
  PAID
  CONTRACTED_WITH
  SUPPLIER_TO
  INVESTED_IN
  SHAREHOLDER_OF
  REPRESENTS
  LOBBIED
  MET_WITH
  SUPPORTED
  PARTNERED_WITH
  VOTED_FOR
  VOTED_AGAINST
  ABSTAINED
  INTRODUCED
  SIGNED
  DECIDED
  SUPERVISES
  REGULATES
  AUDITS
  OWNS_MEDIA
  FAMILY_RELATION
  PART_OF
  CANDIDATE_OF
  SITS_IN
  EDUCATED_AT
  // EU Transparency Register semantics (Sprint C2) — precise, never "INFLUENCES".
  REGISTERED_LOBBY_ORGANIZATION
  REPRESENTS_INTERESTS_OF
  CLIENT_OF
  DECLARED_EU_INTEREST
  ACCREDITED_REPRESENTATIVE_OF
  // Journalism & media (Journalistinen tuotanto) — Media & Toimittajat.
  // WORKED_FOR / PREVIOUSLY_WORKED_FOR / EDITOR_IN_CHIEF_OF describe a
  // role-holding person; WORKS_FOR is the current-state form and must never be
  // used for an ended employment (temporal.ts enforces the lifecycle).
  WORKS_FOR
  WORKED_FOR
  PREVIOUSLY_WORKED_FOR
  EDITOR_OF
  EDITOR_IN_CHIEF_OF
  FOUNDED
  OWNED_BY
  PARTIALLY_OWNS
  PUBLISHES
  PART_OF_MEDIA_GROUP
  SISTER_PUBLICATION_OF
  INTERVIEWED
  CITED
  CITED_AS_EXPERT
  WROTE_ABOUT
  PERSONAL_RELATIONSHIP
  // Political-affiliation edges for the documented-affiliations graph. These
  // are separate from PoliticalAffiliation (the strict A/B/C profile model);
  // both share the temporal + evidence-first rules.
  POLITICAL_CANDIDATE_FOR
  WORKED_FOR_PARTY
  POLITICAL_AIDE_TO
  RECEIVED_FUNDING_FROM
}

enum VerificationState {
  PENDING
  PROPOSED
  PUBLISHED
  REJECTED
  CONFLICTED
}

// Derived, deterministic time state of a relationship (B.5 Phase 4).
enum TemporalState {
  CURRENT
  HISTORICAL
  UNKNOWN_PERIOD
}

// Canonical verification lifecycle (A7). Distinct from the legacy
// VerificationState (kept for back-compat during migration).
//   AUTO_DETECTED    - agent/parser found it; not yet sufficiently confirmed.
//   SOURCE_CONFIRMED - an original/strong public source supports THIS claim.
//   HUMAN_VERIFIED   - a reviewer checked the source and accepted it. Never
//                      set by an agent.
//   DISPUTED         - a credible conflict or correction request exists.
//   REJECTED         - an automated detection was found to be wrong. Not shown
//                      as a normal confirmed connection.
//   STALE            - was valid; current state likely changed or source aged.
//                      Not deleted — history is preserved.
enum VerificationStatus {
  AUTO_DETECTED
  SOURCE_CONFIRMED
  HUMAN_VERIFIED
  DISPUTED
  REJECTED
  STALE
}

model Relationship {
  id                    String             @id @default(uuid()) @db.Uuid
  sourceEntityId        String             @db.Uuid
  targetEntityId        String             @db.Uuid
  sourceEntity          Entity             @relation("RelSource", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity          Entity             @relation("RelTarget", fields: [targetEntityId], references: [id], onDelete: Cascade)
  relationshipType      RelationshipType
  // Temporal model (B.5 Phase 4). startDate/endDate are the canonical
  // validity window (validFrom / validTo). temporalState is derived
  // deterministically at write time by src/lib/temporal.ts.

  startDate        DateTime?         @db.Date
  endDate          DateTime?         @db.Date
  observedAt       DateTime?         // when a source last observed this relationship
  lastConfirmedAt  DateTime?         // when a source last confirmed it still holds
  endedReason      String?
  temporalState    TemporalState     @default(UNKNOWN_PERIOD)
  amount           Decimal?          @db.Decimal(18, 2)
  currency         String?
  percentage       Decimal?          @db.Decimal(6, 2)
  // Ownership semantics (institutional-power foundation). Only meaningful for
  // the OWNS / SHAREHOLDER_OF / BENEFICIAL_OWNER_OF family. A percentage is
  // never inferred: REPORTED from the source or CALCULATED from stated data.
  shareClass       String?
  votingRightsPct  Decimal?          @db.Decimal(6, 2)
  isIndirect       Boolean           @default(false)
  ownershipCalculationStatus OwnershipCalculationStatus?
  // Stable per-source record key for multi-source ownership dedup.
  externalRecordId String?           @unique
  role             String?
  description      String?           @db.Text
  status           EntityStatus      @default(ACTIVE)
  confidence       Confidence        @default(HIGH)
  confidenceScore  Float?            // 0.0-1.0; DB CHECK constraint. Not a proof of fact.
  supportingSourceCount Int          @default(1) // distinct sources corroborating this same edge
  evidenceStrength String? // "single_source" | "multiple_primary" | ...
  verificationState VerificationState @default(PUBLISHED)
  verificationStatus VerificationStatus @default(AUTO_DETECTED)
  firstSeen        DateTime?         @default(now())
  lastVerifiedAt   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String? // agent name or "human"

  evidence          Evidence[]
  changeLogs        ChangeLog[]
  verificationQueue VerificationQueue[]

  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([relationshipType])
  @@index([sourceEntityId, relationshipType])
  @@index([verificationStatus])
  @@index([temporalState])
}

// ---------------------------------------------------------------- money flows

// Institutional classification (Sprint C Phase 9). Independent of country /
// creed / nationality — those are never risk signals.
enum EntityCategory {
  GOVERNMENT
  GOVERNMENT_AGENCY
  STATE_OWNED_COMPANY
  COMPANY
  FOUNDATION
  NGO
  RELIGIOUS_ORGANIZATION
  THINK_TANK
  UNIVERSITY
  INTERNATIONAL_ORGANIZATION
  POLITICAL_PARTY
  MEDIA_ORGANIZATION
  OTHER
}

// Nature of a financial flow (Sprint C Phase 10). Not "influence" — a flow is
// funding / a contract / an investment, described neutrally.
enum FundingType {
  GRANT
  DONATION
  INVESTMENT
  PROCUREMENT
  LOAN
  SPONSORSHIP
  MEMBERSHIP_FEE
  OTHER
}

// ISO-3166 country reference (Sprint C Phase 13). A country is filter / origin
// metadata, never a risk score.
model Country {
  iso2      String   @id // "FI", "QA", "CN", ...
  iso3      String   @unique
  name      String
  region    String? // "Europe", "Middle East", "Asia", ...
  createdAt DateTime @default(now())
}

// A concrete undertaking that foreign funding can attach to (Sprint C Phase 16).
model Project {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  sourceIdentifier  String?   @unique // source's own project/call id — dedup key
  programme         String? // funding programme (e.g. "Creative Europe")
  description       String?   @db.Text
  locationCountry   String? // ISO2
  locationRegion    String?
  municipality      String?
  locationPrecision String    @default("COUNTRY") // COUNTRY | REGION | MUNICIPALITY | ADDRESS | COORDINATE
  latitude          Float?
  longitude         Float?
  startDate         DateTime? @db.Date
  endDate           DateTime? @db.Date
  organizerEntityId String?   @db.Uuid
  funderEntityId    String?   @db.Uuid
  totalFundingEur   Decimal?  @db.Decimal(18, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  flows FinancialFlow[]

  @@index([locationCountry])
  @@index([municipality])
  @@index([programme])
}

enum FlowType {
  POLITICAL_DONATION
  CAMPAIGN_FUNDING
  PUBLIC_GRANT
  GOVERNMENT_SUBSIDY
  MUNICIPAL_GRANT
  EU_FUNDING
  PROCUREMENT
  CONSULTING_PAYMENT
  BOARD_REMUNERATION
  SALARY
  EXECUTIVE_COMPENSATION
  INVESTMENT
  OWNERSHIP
  SPONSORSHIP
  RESEARCH_FUNDING
  FOUNDATION_GRANT
  ASSOCIATION_FUNDING
  PUBLIC_PROJECT_FUNDING
  // Public media finance — rights & content procurement (section 3, 23).
  RIGHTS_PAYMENT
  CONTENT_PROCUREMENT
  OTHER
}

model FinancialFlow {
  id                          String             @id @default(uuid()) @db.Uuid
  payerEntityId               String             @db.Uuid
  recipientEntityId           String             @db.Uuid
  payerEntity                 Entity             @relation("FlowPayer", fields: [payerEntityId], references: [id], onDelete: Cascade)
  recipientEntity             Entity             @relation("FlowRecipient", fields: [recipientEntityId], references: [id], onDelete: Cascade)
  intermediaryEntityId        String?            @db.Uuid
  ultimateBeneficiaryEntityId String?            @db.Uuid
  amount                      Decimal            @db.Decimal(18, 2)
  currency                    String             @default("EUR")
  // Sprint C — foreign funding.
  originalAmount              Decimal?           @db.Decimal(18, 2)
  originalCurrency            String?
  // Stable per-source record key for multi-record dedup (Sprint C2).
  externalRecordId            String?            @unique
  rawFundingType              String? // source's own type label, kept verbatim
  funderCountryCode           String? // ISO2 of the payer's country; null = unknown
  recipientCountryCode        String? // ISO2 of the recipient's country
  isForeign                   Boolean            @default(false) // funder country present and != FI
  fundingType                 FundingType?
  projectId                   String?            @db.Uuid
  project                     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  flowDate                    DateTime?          @db.Date
  periodStart                 DateTime?          @db.Date
  periodEnd                   DateTime?          @db.Date
  periodYear                  Int?
  flowType                    FlowType
  purpose                     String?            @db.Text
  description                 String?            @db.Text
  confidence                  Confidence         @default(HIGH)
  confidenceScore             Float? // 0.0-1.0; DB CHECK constraint.
  verificationState           VerificationState  @default(PUBLISHED)
  verificationStatus          VerificationStatus @default(AUTO_DETECTED)
  sourceCount                 Int                @default(1)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  evidence          Evidence[]
  changeLogs        ChangeLog[]
  verificationQueue VerificationQueue[]

  @@index([payerEntityId])
  @@index([recipientEntityId])
  @@index([flowType])
  @@index([flowDate])
  @@index([currency])
  @@index([verificationStatus])
  @@index([isForeign])
  @@index([funderCountryCode])
  @@index([projectId])
}

// ---------------------------------------------------------------- benefits / gifts / awards / hospitality (section 6)
//
// First-class, generic BenefitEvent model. A benefit event connects the people
// and organisations involved in a gift, award, honour, portrait, commissioned
// work, trip, hospitality or similar documented event. NEVER infer a benefit:
// every row is source-backed, and the auto-publish policy routes everything
// except exact official-register records to the review queue.
//
// Award semantics are kept strictly separate (section 9):
//   received an award     → BenefitEvent (recipient = person)
//   selected the winner   → BenefitEvent with selectionRole "selection"
//   served on a jury      → BenefitEvent with selectionRole "jury"
// These are distinct facts and are stored as distinct rows.

enum BenefitEventType {
  GIFT
  AWARD
  HONOUR
  DECORATION
  PORTRAIT
  TRAVEL
  ACCOMMODATION
  HOSPITALITY
  EVENT_TICKET
  MEAL
  PRIZE
  SPONSORED_TRIP
  COMMISSIONED_WORK
  OTHER
}

// How precise a monetary value is. An ESTIMATED value is NEVER displayed as an
// exact price (section 6, "Never display an estimate as an exact price").
enum ValuePrecision {
  EXACT // audited / official figure
  REPORTED // reported figure, not audited
  CALCULATED // derived from stated data (e.g. 98.4 % × total)
  ESTIMATED // estimate
  UNKNOWN // no value / not disclosed
}

enum BenefitReviewStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  DISPUTED
}

model BenefitEvent {
  id                  String             @id @default(uuid()) @db.Uuid
  eventType           BenefitEventType
  title               String
  description         String?            @db.Text

  // Who participated. All optional: a documented award may only name the
  // recipient; a portrait may name subject + artist + commissioner.
  recipientEntityId   String?            @db.Uuid
  recipientEntity     Entity?            @relation("BenefitRecipient", fields: [recipientEntityId], references: [id], onDelete: SetNull)
  giverEntityId       String?            @db.Uuid
  giverEntity         Entity?            @relation("BenefitGiver", fields: [giverEntityId], references: [id], onDelete: SetNull)
  payerEntityId       String?            @db.Uuid
  payerEntity         Entity?            @relation("BenefitPayer", fields: [payerEntityId], references: [id], onDelete: SetNull)
  beneficiaryEntityId String?            @db.Uuid
  beneficiaryEntity   Entity?            @relation("BenefitBeneficiary", fields: [beneficiaryEntityId], references: [id], onDelete: SetNull)
  // Portrait / commissioned work: subject and artist (section 8).
  subjectEntityId     String?            @db.Uuid
  subjectEntity       Entity?            @relation("BenefitSubject", fields: [subjectEntityId], references: [id], onDelete: SetNull)
  artistEntityId      String?            @db.Uuid
  artistEntity        Entity?            @relation("BenefitArtist", fields: [artistEntityId], references: [id], onDelete: SetNull)

  eventDate           DateTime?          @db.Date
  startDate           DateTime?          @db.Date
  endDate             DateTime?          @db.Date
  monetaryValue       Decimal?           @db.Decimal(18, 2)
  currency            String?
  valueType           ValuePrecision     @default(UNKNOWN)
  publicFundsUsed     Boolean? // documented public-funds involvement (null = not documented)
  country             String? // ISO-3166 alpha-2
  selectionRole       String? // "winner" | "selection" | "jury" | other documented role

  verificationStatus  VerificationStatus @default(AUTO_DETECTED)
  confidence          Confidence         @default(HIGH)
  confidenceScore     Float?
  reviewStatus        BenefitReviewStatus @default(PENDING_REVIEW)
  reviewedBy          String?
  reviewedAt          DateTime?
  evidenceGrade       EvidenceGrade      @default(C)
  sourceId            String?            @db.Uuid
  source              Source?            @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  dedupeKey           String?            @unique
  createdBy           String? // agent name or "human"
  lastVerifiedAt      DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([recipientEntityId])
  @@index([giverEntityId])
  @@index([payerEntityId])
  @@index([beneficiaryEntityId])
  @@index([subjectEntityId])
  @@index([artistEntityId])
  @@index([eventType])
  @@index([reviewStatus])
  @@index([verificationStatus])
  @@index([eventDate])
}

// ---------------------------------------------------------------- financial statements (section 3)
//
// Year-by-year audited income/expenditure line items of an organisation's
// public financial statements. Kept separate from FinancialFlow: a statement
// line item is a category total from an annual report (e.g. "henkilöstökulut
// 262,1 M€"), NOT an entity-to-entity money movement. Entity-level movements
// are recorded as FinancialFlow rows (e.g. state appropriation → Yle). The two
// views are never summed together without explaining the calculation.
// `isTotal` marks the grand-total line so aggregations never double-count a
// parent and its child categories (section 43).

enum StatementKind {
  INCOME
  EXPENDITURE
}

model FinancialStatementItem {
  id            String            @id @default(uuid()) @db.Uuid
  entityId      String            @db.Uuid
  entity        Entity            @relation(fields: [entityId], references: [id], onDelete: Cascade)
  fiscalYear    Int
  kind          StatementKind
  category      String // stable machine key, e.g. "YLE_APPROPRIATION", "PERSONNEL_COSTS"
  categoryLabel String // human label, e.g. "Henkilöstökulut"
  amount        Decimal           @db.Decimal(18, 2)
  currency      String            @default("EUR")
  valueType     ValuePrecision    @default(EXACT)
  isTotal       Boolean           @default(false)
  note          String?           @db.Text
  reportUrl     String // the official document this line comes from
  sourceId      String?           @db.Uuid
  source        Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  dedupeKey     String?           @unique
  createdBy     String? // agent name or "human"
  lastVerifiedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([entityId, fiscalYear, kind, category, reportUrl])
  @@index([entityId, fiscalYear])
  @@index([entityId, kind])
  @@index([fiscalYear])
}

// ---------------------------------------------------------------- positions
//
// Position IS the generic temporal RoleAssignment (institutional-power
// foundation). A person may hold many simultaneous roles; every role is dated,
// source-backed and evidence-graded. `role` keeps the free-text title, `roleType`
// is the machine-readable classification (never mutually exclusive).

model Position {
  id                 String        @id @default(uuid()) @db.Uuid
  personEntityId     String        @db.Uuid
  personEntity       Entity        @relation("PositionPerson", fields: [personEntityId], references: [id], onDelete: Cascade)
  organizationEntityId String?     @db.Uuid
  organizationEntity Entity?       @relation("PositionOrg", fields: [organizationEntityId], references: [id], onDelete: SetNull)
  role               String
  roleType           RoleType?
  department         String?
  startDate          DateTime?     @db.Date // validFrom
  endDate            DateTime?     @db.Date // validTo
  isCurrent          Boolean       @default(true)
  appointmentMethod  String? // canonical values: NOMINATION | ELECTION | APPOINTMENT | OWNER_DECISION | SECONDMENT | OTHER
  appointedByEntityId String?      @db.Uuid
  appointedByEntity  Entity?       @relation("PositionAppointedBy", fields: [appointedByEntityId], references: [id], onDelete: SetNull)
  sourceId           String?       @db.Uuid
  source             Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  evidenceGrade      EvidenceGrade @default(C)
  verificationStatus VerificationStatus @default(SOURCE_CONFIRMED)
  lastVerifiedAt     DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([personEntityId])
  @@index([organizationEntityId])
  @@index([roleType])
  @@index([appointedByEntityId])
  @@index([isCurrent, roleType])
}

// ---------------------------------------------------------------- decisions & votes

model Decision {
  id                  String     @id @default(uuid()) @db.Uuid
  title               String
  institutionEntityId String?    @db.Uuid
  institutionEntity   Entity?    @relation("InstitutionDecisions", fields: [institutionEntityId], references: [id], onDelete: SetNull)
  decisionDate        DateTime?  @db.Date
  decisionType        String?
  description         String?    @db.Text
  legalBasis          String?
  financialValue      Decimal?   @db.Decimal(18, 2)
  currency            String?
  affectedSectors     String[]   @default([])
  affectedRegions     String[]   @default([])
  sourceId            String?    @db.Uuid
  source              Source?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  confidence          Confidence @default(HIGH)
  votes               Vote[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // VAIKUTA module: optional link to a matching DECISION entity (used so
  // decision authorship can be expressed with ordinary Relationship edges).
  entityId  String?   @unique @db.Uuid
  entity    Entity?   @relation("DecisionEntity", fields: [entityId], references: [id], onDelete: SetNull)

  campaigns InfluenceCampaign[]
  stages    DecisionStage[]

  @@index([institutionEntityId])
  @@index([decisionDate])
}

enum VoteChoice {
  FOR
  AGAINST
  ABSTAIN
  ABSENT
}

model Vote {
  id             String     @id @default(uuid()) @db.Uuid
  decisionId     String     @db.Uuid
  decision       Decision   @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  personEntityId String     @db.Uuid
  personEntity   Entity     @relation(fields: [personEntityId], references: [id], onDelete: Cascade)
  choice         VoteChoice

  @@unique([decisionId, personEntityId])
  @@index([personEntityId])
}

// ---------------------------------------------------------------- events

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  entityId    String    @db.Uuid
  entity      Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  eventType   String
  eventDate   DateTime? @db.Date
  description String?   @db.Text
  sourceId    String?   @db.Uuid
  source      Source?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([entityId, eventDate])
}

// ---------------------------------------------------------------- sources & evidence

enum SourceType {
  OFFICIAL_PRIMARY
  OFFICIAL_REGISTER
  COURT_DOCUMENT
  PARLIAMENTARY_RECORD
  COMPANY_DISCLOSURE
  ANNUAL_REPORT
  PROCUREMENT_RECORD
  ORGANIZATION_DISCLOSURE
  ACADEMIC_SOURCE
  REPUTABLE_MEDIA
  SECONDARY_MEDIA
  OTHER
}

model Source {
  id                  String     @id @default(uuid()) @db.Uuid
  sourceUrl           String
  sourceName          String
  publisher           String?
  publicationDate     DateTime?  @db.Date
  retrievedAt         DateTime?  @default(now())
  documentTitle       String?
  sourceType          SourceType @default(OTHER)
  confidence          Confidence @default(HIGH)
  archivedHash        String?
  parserVersion       String?
  lastCheckedAt       DateTime?
  lastChangedAt       DateTime?
  // Source health (Phase 15): status + consecutive failure tracking.
  status              String     @default("ACTIVE") // ACTIVE | DEGRADED | FAILED | DISABLED
  consecutiveFailures Int        @default(0)
  lastSuccessAt       DateTime?
  createdAt           DateTime   @default(now())

  evidence  Evidence[]
  positions Position[]
  decisions Decision[]
  events    Event[]
  agentRuns AgentRun[]
  articles  Article[]
  benefitEvents          BenefitEvent[]
  financialStatementItems FinancialStatementItem[]

  // VAIKUTA module
  campaignRecipients CampaignRecipient[]
  vaikutaContacts    VaikutaContactMethod[]
  decisionStages     DecisionStage[]

  // Institutional power (foundation).
  organizationSectors         OrganizationSector[] @relation("OrgSectorSource")
  criticalFunctionAssignments CriticalFunctionAssignment[] @relation("CriticalFunctionSource")
  procurementContracts        ProcurementContract[] @relation("ProcurementSource")
  lobbyingEngagements         LobbyingEngagement[] @relation("LobbyingSource")

  // Institutional power (public-institutions stream).
  institutionalCategories     OrganizationInstitutionalCategory[] @relation("InstitutionalCategorySource")

  @@unique([sourceUrl])
  @@index([sourceType])
}

// Evidence links a fact (relationship / flow / decision) to its source.
model Evidence {
  id             String         @id @default(uuid()) @db.Uuid
  relationshipId String?        @db.Uuid
  relationship   Relationship?  @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  flowId         String?        @db.Uuid
  flow           FinancialFlow? @relation(fields: [flowId], references: [id], onDelete: Cascade)
  entityId       String?        @db.Uuid
  entity         Entity?        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  sourceId       String         @db.Uuid
  source         Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  quotedFragment String?        @db.Text
  page           String?
  documentTitle  String?
  parserVersion  String?
  confidence     Confidence     @default(HIGH)
  createdAt      DateTime       @default(now())

  @@index([relationshipId])
  @@index([flowId])
  @@index([entityId])
  @@index([sourceId])
}

// ---------------------------------------------------------------- source registry (Sprint B)

// How much intrinsic authority a source carries. Never a country/creed signal —
// only document provenance strength.
enum ReliabilityTier {
  OFFICIAL_PRIMARY // law/registry/parliament: the authoritative record itself
  OFFICIAL_REGISTER // official register extract / open-data API
  PUBLIC_DISCLOSURE // mandated disclosure (declarations of interest, filings)
  ANNUAL_REPORT // organisation's own published report
  REPUTABLE_MEDIA
  OTHER
}

// Central registry of ingestion sources. One row per ingestion source, seeded
// from the code adapters (src/lib/agents/*). Distinct from `Source`, which is a
// per-document evidence record. `id` matches the adapter id.
model IngestionSource {
  id                  String          @id
  name                String
  publisher           String
  baseUrl             String
  sourceType          SourceType
  adapter             String // adapter id used to ingest (== id for now)
  reliabilityTier     ReliabilityTier @default(OFFICIAL_PRIMARY)
  format              String          @default("API") // API | HTML | PDF | RSS
  updateCadence       String          @default("daily") // daily | weekly | monthly
  enabled             Boolean         @default(true)
  termsUrl            String?
  notes               String?         @db.Text
  lastCheckedAt       DateTime?
  lastSuccessAt       DateTime?
  lastErrorAt         DateTime?
  lastError           String?         @db.Text
  consecutiveFailures Int             @default(0)
  // Rolling counters from the most recent completed run (Phase 15/16).
  lastRunDocsChecked  Int             @default(0)
  lastRunDocsChanged  Int             @default(0)
  lastRunDurationMs   Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  documents SourceDocument[]

  @@index([enabled])
}

// Lifecycle of one unit of ingested source material (Phase 2). One row per
// (source, externalId); revisions are tracked by contentHash + lastChangedAt.
enum DocumentProcessingStatus {
  PENDING
  PROCESSED
  FAILED
  SKIPPED_UNCHANGED
}

model SourceDocument {
  id                String                   @id @default(uuid()) @db.Uuid
  ingestionSourceId String
  ingestionSource   IngestionSource          @relation(fields: [ingestionSourceId], references: [id], onDelete: Cascade)
  externalId        String // stable per-source document id
  canonicalUrl      String
  documentType      String                   @default("json") // json | html | pdf | text
  title             String?
  publishedAt       DateTime?
  retrievedAt       DateTime                 @default(now())
  contentHash       String
  mimeType          String?
  rawJson           Json?
  rawText           String?                  @db.Text
  storageRef        String? // object-storage key when the payload is too large for a column
  parserVersion     String?
  processingStatus  DocumentProcessingStatus @default(PENDING)
  processingError   String?                  @db.Text
  firstSeenAt       DateTime                 @default(now())
  lastSeenAt        DateTime                 @default(now())
  lastChangedAt     DateTime                 @default(now())
  revision          Int                      @default(1)
  metadata          Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([ingestionSourceId, externalId])
  @@index([ingestionSourceId, processingStatus])
  @@index([contentHash])
}

// Entity resolution that could not be decided deterministically or with a
// single confident name match — parked for human review instead of guessing
// (Phase 5). The fact that produced it is NOT published until resolved.
model EntityResolutionCandidate {
  id                    String     @id @default(uuid()) @db.Uuid
  ingestionSourceId     String?
  refName               String
  refType               EntityType
  refJurisdiction       String?
  refExternalProvider   String?
  refExternalIdentifier String?
  candidateEntityIds    String[]   @default([]) // possible matches, for the reviewer
  context               Json? // the EntityRef + surrounding fact context
  status                String     @default("PENDING") // PENDING | RESOLVED | DISMISSED
  resolvedEntityId      String?    @db.Uuid
  resolvedBy            String?
  createdAt             DateTime   @default(now())
  resolvedAt            DateTime?

  @@index([status])
  @@index([refType, refName])
}

// A proposed relationship that has NOT been published. The published
// Relationship table is never an agent scratchpad (B.5 Phase 3): deterministic
// official facts still publish directly, everything else lands here for a
// verification decision (auto-acceptable) or human review.
enum CandidateStatus {
  PENDING
  AUTO_ACCEPTABLE
  NEEDS_REVIEW
  ACCEPTED
  REJECTED
  DUPLICATE
  CONFLICT
}

model RelationshipCandidate {
  id                      String           @id @default(uuid()) @db.Uuid
  sourceEntityRef         Json // unresolved EntityRef as proposed
  targetEntityRef         Json
  resolvedSourceEntityId  String?          @db.Uuid
  resolvedTargetEntityId  String?          @db.Uuid
  relationshipType        RelationshipType
  role                    String?
  amount                  Decimal?         @db.Decimal(18, 2)
  currency                String?
  proposedValidFrom       DateTime?        @db.Date
  proposedValidTo         DateTime?        @db.Date
  confidenceScore         Float?
  extractionMethod        String           @default("deterministic-parser") // deterministic-parser | rule | llm | manual
  extractorVersion        String?
  sourceDocumentId        String?          @db.Uuid
  evidenceUrl             String
  evidenceTitle           String?
  sourceType              SourceType
  sourceName              String
  publisher               String
  agentRunId              String?          @db.Uuid
  status                  CandidateStatus  @default(PENDING)
  publishedRelationshipId String?          @db.Uuid
  rejectionReason         String?
  reviewedAt              DateTime?
  reviewedBy              String?
  createdAt               DateTime         @default(now())

  @@index([status])
  @@index([relationshipType])
  @@index([sourceDocumentId])
}

// A genuine contradiction between sources about the same relationship that the
// temporal resolver could not settle (B.5 Phase 8). Parked for admin review;
// nothing is auto-treated as an error.
model SourceConflict {
  id             String    @id @default(uuid()) @db.Uuid
  relationshipId String?   @db.Uuid
  entityId       String?   @db.Uuid
  kind           String // ended_vs_active | value_mismatch | role_mismatch | other
  claimA         Json // { text, sourceUrl, sourceName, observedAt }
  claimB         Json
  status         String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  resolution     String?   @db.Text
  resolvedBy     String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([status])
  @@index([relationshipId])
}

// Cached network-analytics result (Sprint C3). Keyed by scope + filters +
// algorithm version. Recomputed when the underlying graph changes.
model NetworkAnalytics {
  id                String   @id @default(uuid()) @db.Uuid
  scope             String // organisational | funding | decision | ownership | international
  scopeHash         String   @unique
  filters           Json
  temporal          String   @default("current") // current | historical | all
  algorithm         String   @default("degree+brandes-betweenness")
  algorithmVersion  String
  nodeCount         Int
  edgeCount         Int
  result            Json
  graphMaxUpdatedAt DateTime
  calculatedAt      DateTime @default(now())

  @@index([scope])
}

// Immutable audit trail for every human review action (Phase 12). Actor is the
// role ("admin"), never PII.
model ReviewAction {
  id         String   @id @default(uuid()) @db.Uuid
  actor      String   @default("admin")
  targetType String // relationship | resolution_candidate | correction
  targetId   String
  action     String // approve | reject | dispute | stale | resolve | dismiss | edit | investigate
  beforeData Json?
  afterData  Json?
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// ---------------------------------------------------------------- agents & ops

model AgentRun {
  id                 String    @id @default(uuid()) @db.Uuid
  agent              String
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  sourceId           String?   @db.Uuid
  source             Source?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  recordsScanned     Int       @default(0)
  factsProposed      Int       @default(0)
  factsAccepted      Int       @default(0)
  factsRejected      Int       @default(0)
  recordsCreated     Int       @default(0)
  recordsUpdated     Int       @default(0)
  // Collector-framework document counters (Phase 4).
  documentsChecked   Int       @default(0)
  documentsNew       Int       @default(0)
  documentsChanged   Int       @default(0)
  documentsUnchanged Int       @default(0)
  errors             Int       @default(0)
  cost               Decimal?  @db.Decimal(10, 4)
  status             String    @default("RUNNING") // RUNNING | SUCCESS | PARTIAL | FAILED | SKIPPED
  details            String?   @db.Text
  metadata           Json?
  // Run-lock fields: prevents overlapping runs of the same agent.
  lockToken          String?   @db.Uuid
  lockUntil          DateTime?
  createdAt          DateTime  @default(now())

  findings AgentFinding[]

  @@index([agent, startedAt])
  @@index([status, startedAt])
}

model AgentFinding {
  id          String   @id @default(uuid()) @db.Uuid
  runId       String   @db.Uuid
  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  findingType String // RELATIONSHIP_ADDED, POSITION_CHANGED, ...
  summary     String?  @db.Text
  data        Json?
  createdAt   DateTime @default(now())
}

model VerificationQueue {
  id             String         @id @default(uuid()) @db.Uuid
  relationshipId String?        @db.Uuid
  relationship   Relationship?  @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  flowId         String?        @db.Uuid
  flow           FinancialFlow? @relation(fields: [flowId], references: [id], onDelete: Cascade)
  entityId       String?        @db.Uuid
  priority       Int            @default(5)
  status         String         @default("PENDING") // PENDING | APPROVED | REJECTED
  reason         String?        @db.Text
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
}

// ---------------------------------------------------------------- change feed

enum ChangeEventType {
  RELATIONSHIP_ADDED
  RELATIONSHIP_ENDED
  AMOUNT_CHANGED
  POSITION_CHANGED
  OWNER_CHANGED
  NEW_APPOINTMENT
  NEW_GRANT
  NEW_CONTRACT
  NEW_VOTE
  ENTITY_ADDED
  ENTITY_UPDATED
  SOURCE_ADDED
  IDENTITY_MERGED
}

model ChangeLog {
  id             String          @id @default(uuid()) @db.Uuid
  eventType      ChangeEventType
  entityId       String?         @db.Uuid
  entity         Entity?         @relation(fields: [entityId], references: [id], onDelete: SetNull)
  relationshipId String?         @db.Uuid
  relationship   Relationship?   @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  flowId         String?         @db.Uuid
  flow           FinancialFlow?  @relation(fields: [flowId], references: [id], onDelete: SetNull)
  sourceId       String?         @db.Uuid
  description    String?         @db.Text
  beforeData     Json?
  afterData      Json?
  occurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  @@index([occurredAt])
  @@index([entityId])
  @@index([eventType])
}

// ---------------------------------------------------------------- corrections & methodology

enum CorrectionStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  DUPLICATE
}

model Correction {
  id                String           @id @default(uuid()) @db.Uuid
  entityId          String?          @db.Uuid
  entity            Entity?          @relation(fields: [entityId], references: [id], onDelete: SetNull)
  reporter          String?
  reporterEmail     String?
  category          String // incorrect_person | wrong_relationship | outdated_role | incorrect_amount | missing_source | identity_collision | other
  description       String?          @db.Text
  status            CorrectionStatus @default(SUBMITTED)
  moderationHistory Json?
  createdAt         DateTime         @default(now())
  resolvedAt        DateTime?

  @@index([status])
}

model MethodologyVersion {
  id          String   @id @default(uuid()) @db.Uuid
  version     String
  title       String
  content     String   @db.Text
  publishedAt DateTime @default(now())

  @@unique([version])
}

model RightOfReply {
  id               String   @id @default(uuid()) @db.Uuid
  entityId         String   @db.Uuid
  entity           Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  responder        String
  content          String   @db.Text
  createdAt        DateTime @default(now())
  isEntityResponse Boolean  @default(true)

  @@index([entityId])
}

// ================================================================ VAIKUTA module
//
// Vaikuta links the public influence graph to legitimate citizen
// participation. All recipient relevance is derived from documented,
// source-backed institutional relationships — never from inferred political
// beliefs. Money is stored in integer minor units (amountMinor); 1490 = €14.90.
// No floating point is ever used for money.

enum VaikutaUserStatus {
  ACTIVE
  SUSPENDED
}

model VaikutaUser {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  identityLevel   String           @default("email_verified") // email_verified | strong | organization_verified (future)
  status          VaikutaUserStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  subscriptions    VaikutaSubscription[]
  campaigns        InfluenceCampaign[]
  payments         VaikutaPayment[]
  checkoutSessions VaikutaCheckoutSession[]
  events           VaikutaEvent[]
  verificationTokens VaikutaVerificationToken[]

  @@index([status])
}

model VaikutaPlan {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique // FREE | VAIKUTA_PASS | VAIKUTA_PLUS | VAIKUTA_PRO | ORGANIZATION
  name              String
  billingPeriod     String   @default("one_time") // one_time | monthly | yearly
  priceMinor        Int      @default(0) // integer minor units — never a float
  currency          String   @default("EUR")
  recipientLimit    Int? // per-campaign eligible-recipient cap; null = tier default
  campaignAllowance Int? // per billing period; null = tier default
  aiAssist          Boolean  @default(true)
  monitoring        Boolean  @default(false)
  features          Json? // display line items
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt

  subscriptions VaikutaSubscription[]
}

enum VaikutaSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model VaikutaSubscription {
  id                     String                    @id @default(uuid()) @db.Uuid
  userId                 String                    @db.Uuid
  user                   VaikutaUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String                    @db.Uuid
  plan                   VaikutaPlan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                 VaikutaSubscriptionStatus @default(ACTIVE)
  currentPeriodEnd       DateTime?
  provider               String                    @default("mock")
  providerSubscriptionId String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([userId, status])
}

enum VaikutaCheckoutStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

model VaikutaCheckoutSession {
  id                String                 @id @default(uuid()) @db.Uuid
  userId            String                 @db.Uuid
  user              VaikutaUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId        String?                @db.Uuid
  campaign          InfluenceCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  planId            String?                @db.Uuid
  amountMinor       Int                    @default(0)
  currency          String                 @default("EUR")
  status            VaikutaCheckoutStatus  @default(CREATED)
  provider          String                 @default("mock")
  providerSessionId String?
  isMock            Boolean                @default(true)
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([userId, status])
  @@index([providerSessionId])
}

enum VaikutaPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model VaikutaPayment {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @db.Uuid
  user              VaikutaUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkoutSessionId String?              @db.Uuid
  amountMinor       Int
  currency          String               @default("EUR")
  status            VaikutaPaymentStatus @default(PENDING)
  provider          String               @default("mock")
  providerPaymentId String?
  providerChargeId  String? // Stripe Charge/PaymentIntent id when live
  receiptUrl        String?
  isMock            Boolean              @default(true)
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId])
  @@index([checkoutSessionId])
}

enum VaikutaCampaignStatus {
  DRAFT
  RECIPIENTS_SELECTED
  MESSAGE_READY
  APPROVED
  CHECKOUT_READY
  PAYMENT_COMPLETED
  DELIVERED
  CLOSED
  SUSPENDED
  REQUIRES_MODERATION
}

enum VaikutaCampaignDeliveryStatus {
  PENDING
  QUEUED
  ACCEPTED
  SIMULATED_DELIVERED
  FAILED
}

model InfluenceCampaign {
  id                  String                        @id @default(uuid()) @db.Uuid
  userId              String                        @db.Uuid
  user                VaikutaUser                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisionId          String                        @db.Uuid
  decision            Decision                      @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  status              VaikutaCampaignStatus         @default(DRAFT)
  title               String
  messageSubject      String?
  messageBody         String?                       @db.Text
  approvedAt          DateTime?
  paymentStatus       VaikutaPaymentStatus?
  deliveryStatus      VaikutaCampaignDeliveryStatus @default(PENDING)
  planCode            String                        @default("FREE")
  planSnapshot        Json?
  pricingVersion      String?
  publicVisibility    String                        @default("PRIVATE") // PRIVATE | PUBLIC
  publicStatement     String?                       @db.Text
  isDemo              Boolean                       @default(false)
  abuseFlaggedAt      DateTime?
  abuseReason         String?                       @db.Text
  suspendedAt         DateTime?
  deliveryProvider    String?
  deliveryProviderState Json?
  preparedMessageAt   DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  recipients CampaignRecipient[]
  events     CampaignEvent[]
  checkoutSessions VaikutaCheckoutSession[]
  vaikutaEvents VaikutaEvent[]
  responses CampaignResponse[]

  @@index([userId, createdAt])
  @@index([decisionId])
  @@index([status])
  @@index([isDemo])
}

model CampaignRecipient {
  id                String                       @id @default(uuid()) @db.Uuid
  campaignId        String                       @db.Uuid
  campaign          InfluenceCampaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entityId          String                       @db.Uuid
  entity            Entity                       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  recipientRole     String?
  recipientReason   String?
  relevanceDimension String // committee_membership | vote | chair_of_committee | minister | mp_plenary | media_coverage | official_preparation | formal_authorship
  isMedia           Boolean                      @default(false)
  relationshipType  String?
  sourceId          String?                      @db.Uuid
  source            Source?                      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  confidence        Confidence                   @default(HIGH)
  verifiedAt        DateTime?
  contactMethod     String? // professional_email | official_webform_url | official_address | newsroom_contact | none_available
  contactAvailability String                     @default("not_verified") // verified | public_professional | not_verified
  contactVerifiedAt DateTime?
  deliveryStatus    VaikutaCampaignDeliveryStatus @default(PENDING)
  responseStatus    String? // reply | awaiting_reply | no_response
  createdAt         DateTime                     @default(now())

  @@unique([campaignId, entityId])
  @@index([entityId])
}

model CampaignEvent {
  id         String          @id @default(uuid()) @db.Uuid
  campaignId String          @db.Uuid
  campaign   InfluenceCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type       String // created | recipient_added | recipient_removed | message_updated | message_approved | checkout_started | payment_simulated | delivery_simulated | response_recorded | campaign_closed | campaign_suspended | moderation_required
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([campaignId, createdAt])
}

model VaikutaEvent {
  id         String           @id @default(uuid()) @db.Uuid
  eventType  String // vaikuta_opened | decision_selected | recipient_list_viewed | recipient_selected | message_started | ai_assist_used | preview_opened | checkout_started | mock_checkout_completed | campaign_created | campaign_completed
  userId     String?          @db.Uuid
  user       VaikutaUser?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaignId String?          @db.Uuid
  campaign   InfluenceCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  decisionId String?          @db.Uuid
  metadata   Json? // NEVER full message contents — analytics must stay generic
  createdAt  DateTime         @default(now())

  @@index([eventType, createdAt])
  @@index([userId])
}

model VaikutaContactMethod {
  id                  String   @id @default(uuid()) @db.Uuid
  entityId            String   @db.Uuid
  entity              Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  contactType         String // professional_email | official_webform_url | official_address | newsroom_contact | official_phone
  value               String // value is ONLY ever a documented public/professional contact
  label               String?
  sourceId            String?  @db.Uuid
  source              Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  isPublicProfessional Boolean @default(false)
  verifiedAt          DateTime?
  createdAt           DateTime @default(now())

  @@unique([entityId, contactType, value])
  @@index([entityId])
}

model VaikutaVerificationToken {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      VaikutaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  purpose   String      @default("email_verification")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([userId, purpose])
}

model CampaignResponse {
  id                String             @id @default(uuid()) @db.Uuid
  campaignId        String             @db.Uuid
  campaign          InfluenceCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientEntityId String?            @db.Uuid
  kind              String             @default("delivery") // delivery | reply | manual
  summary           String?            @db.Text
  receivedAt        DateTime           @default(now())
  createdAt         DateTime           @default(now())

  @@index([campaignId, receivedAt])
}

// Decision timeline used by Vaikuta "Seuraa päätöstä". Dates/sourceId are
// procedural facts; "next opportunity to influence" is only ever inferred from
// a documented stage, never manufactured.
model DecisionStage {
  id         String   @id @default(uuid()) @db.Uuid
  decisionId String   @db.Uuid
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  stageType  String // INTRODUCED | COMMITTEE_CONSIDERATION | HEARINGS | COMMITTEE_REPORT | PLENARY_DISCUSSION | VOTE | PRESIDENTIAL_CONFIRMATION | EFFECTIVE | NEXT_OPPORTUNITY
  label      String
  date       DateTime? @db.Date
  detail     String?  @db.Text
  sourceId   String?  @db.Uuid
  source     Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([decisionId, date])
  @@index([stageType])
}

// ---------------------------------------------------------------- institutional power (foundation)
//
// OrganizationSector: neutral sector classification, multiple allowed per
// organisation. Assigned only when a public source documents it. A sector is
// descriptive, never an influence or risk signal.
model OrganizationSector {
  id           String        @id @default(uuid()) @db.Uuid
  entityId     String        @db.Uuid
  entity       Entity        @relation("OrgSectors", fields: [entityId], references: [id], onDelete: Cascade)
  sector       Sector
  sourceId     String?       @db.Uuid
  source       Source?       @relation("OrgSectorSource", fields: [sourceId], references: [id], onDelete: SetNull)
  evidenceGrade EvidenceGrade @default(C)
  validFrom    DateTime?     @db.Date
  validTo      DateTime?     @db.Date
  createdBy    String? // agent name or "human"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([entityId, sector])
  @@index([sector])
  @@index([entityId, validTo])
}

// ------------------------------------------------- institutional power (public-institutions stream, section 5/23)
//
// InstitutionalCategory: a structural, descriptive institutional type for an
// organisation (ministry, agency, municipality, wellbeing services county,
// state enterprise, NGO, foundation, labour-market organisation, ...). A
// category is a fact about what the organisation IS — never an influence or
// ideology signal. Multiple categories may be assigned when a public source
// documents them; each assignment is source-bound and evidence-graded.
model OrganizationInstitutionalCategory {
  id           String               @id @default(uuid()) @db.Uuid
  entityId     String               @db.Uuid
  entity       Entity               @relation("InstitutionalCategories", fields: [entityId], references: [id], onDelete: Cascade)
  category     InstitutionalCategory
  sourceId     String?              @db.Uuid
  source       Source?              @relation("InstitutionalCategorySource", fields: [sourceId], references: [id], onDelete: SetNull)
  evidenceGrade EvidenceGrade       @default(C)
  validFrom    DateTime?            @db.Date
  validTo      DateTime?            @db.Date
  createdBy    String? // agent name or "human"
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([entityId, category])
  @@index([category])
  @@index([entityId, validTo])
}

enum InstitutionalCategory {
  MINISTRY // ministeriö
  PRIME_MINISTERS_OFFICE // valtioneuvoston kanslia
  AGENCY // virasto / yleinen viranomainen
  AUTHORITY // valvova / sääntelevä viranomainen
  STATE_ENTERPRISE // valtion liikelaitos
  STATE_OWNED_COMPANY // valtion omistama yhtiö
  STATE_SPECIAL_ASSIGNMENT_COMPANY // valtion erityistehtäväyhtiö
  STATE_INVESTMENT_COMPANY // valtion sijoitusyhtiö
  PUBLIC_FINANCING_INSTITUTION // julkinen rahoituslaitos
  STATE_FUND // valtion rahasto (esim. Sitra)
  MUNICIPALITY // kunta
  WELLBEING_SERVICES_COUNTY // hyvinvointialue
  MUNICIPAL_OWNED_COMPANY // kunnan omistama yhtiö
  REGIONAL_COUNCIL // maakunnan liitto
  NGO // kansalaisjärjestö
  FOUNDATION // säätiö
  ASSOCIATION // yhdistys
  EMPLOYER_ORGANIZATION // työnantajajärjestö
  TRADE_UNION // ammattiliitto
  PROFESSIONAL_ORGANIZATION // ammatillinen järjestö
  LABOUR_MARKET_CENTRAL_ORGANIZATION // työmarkkinoiden keskusjärjestö
  INDUSTRY_ASSOCIATION // toimialajärjestö
  CHAMBER_OF_COMMERCE // kauppakamari
  WORKING_GROUP // työryhmä
  ADVISORY_BODY // neuvottelukunta / asiantuntijaelin
  COMMISSION // komissio / toimikunta
  COUNCIL // neuvosto
  OTHER
}

// CriticalFunctionAssignment: a nationally significant function performed by an
// organisation, labelled ONLY with a public basis. Never reconstructed from
// classified infrastructure, HVK lists, emergency plans or hidden dependencies.
model CriticalFunctionAssignment {
  id                   String        @id @default(uuid()) @db.Uuid
  entityId             String        @db.Uuid
  entity               Entity        @relation("CriticalFunctions", fields: [entityId], references: [id], onDelete: Cascade)
  function             CriticalFunction
  classificationSource String // who classified (adapter id or "human")
  publicBasis          String        @db.Text // the public evidence basis for the label
  confidence           Confidence    @default(HIGH)
  evidenceGrade        EvidenceGrade @default(C)
  sourceId             String?       @db.Uuid
  source               Source?       @relation("CriticalFunctionSource", fields: [sourceId], references: [id], onDelete: SetNull)
  createdBy            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([entityId, function, publicBasis])
  @@index([function])
  @@index([entityId])
}

// ProcurementContract: a documented public-procurement relationship between a
// contracting authority and a supplier. Procurement is a RELATIONSHIP, not an
// influence edge — the public UI labels it "Hankintasuhde", never "Vaikuttaa".
model ProcurementContract {
  id                            String             @id @default(uuid()) @db.Uuid
  contractingAuthorityEntityId  String             @db.Uuid
  contractingAuthority          Entity             @relation("ProcurementAuthority", fields: [contractingAuthorityEntityId], references: [id], onDelete: Cascade)
  supplierEntityId              String             @db.Uuid
  supplier                      Entity             @relation("ProcurementSupplier", fields: [supplierEntityId], references: [id], onDelete: Cascade)
  value                         Decimal?           @db.Decimal(18, 2)
  currency                      String             @default("EUR")
  cpv                           String? // CPV code
  procedure                     ProcurementProcedure?
  publicationUrl                String?
  awardDate                     DateTime?          @db.Date
  noticeId                      String?
  description                   String?            @db.Text
  confidence                    Confidence         @default(HIGH)
  evidenceGrade                 EvidenceGrade      @default(C)
  verificationStatus            VerificationStatus @default(AUTO_DETECTED)
  sourceId                      String?            @db.Uuid
  source                        Source?            @relation("ProcurementSource", fields: [sourceId], references: [id], onDelete: SetNull)
  dedupeKey                     String?            @unique
  createdBy                     String?
  lastVerifiedAt                DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  @@index([contractingAuthorityEntityId])
  @@index([supplierEntityId])
  @@index([cpv])
  @@index([awardDate])
}

// LobbyingEngagement: an organisation's documented lobbying activity toward a
// target (e.g. from a transparency register). Lobbying is NEVER transformed into
// corruption or political alignment — it is recorded as a neutral, source-backed
// relationship with reported financial resources where available.
model LobbyingEngagement {
  id                         String             @id @default(uuid()) @db.Uuid
  organizationEntityId       String             @db.Uuid
  organization               Entity             @relation("LobbyingOrganization", fields: [organizationEntityId], references: [id], onDelete: Cascade)
  targetEntityId             String             @db.Uuid
  target                     Entity             @relation("LobbyingTarget", fields: [targetEntityId], references: [id], onDelete: Cascade)
  subject                    String?            @db.Text
  communicationMethod        String?
  periodStart                DateTime?          @db.Date
  periodEnd                  DateTime?          @db.Date
  reportedFinancialResources Decimal?           @db.Decimal(18, 2)
  currency                   String?
  confidence                 Confidence         @default(HIGH)
  evidenceGrade              EvidenceGrade      @default(C)
  verificationStatus         VerificationStatus @default(AUTO_DETECTED)
  sourceId                   String?            @db.Uuid
  source                     Source?            @relation("LobbyingSource", fields: [sourceId], references: [id], onDelete: SetNull)
  dedupeKey                  String?            @unique
  createdBy                  String?
  lastVerifiedAt             DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([organizationEntityId])
  @@index([targetEntityId])
  @@index([periodStart])
}
